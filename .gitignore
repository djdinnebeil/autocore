# Build outputs (plain names also ignore machine-local directory symlinks).
# Published binaries in /bin are tracked. Other bin/ directories stay ignored.
bin/
!/bin/
!/bin/**
!third_party/
!third_party/*/
!third_party/*/bin/
!third_party/*/bin/**
obj/
obj
out/
out
Debug/
Release/
x64/
x86/

# Compiled binaries and debug symbols
*.exe
!/bin/*.exe
*.pdb
*.obj
*.ilk
*.aps

# Leftover generated core outputs if an older layout still has them
# (vendored third-party .lib files stay under third_party/<dep>/lib).
# Disposable intermediates are obj/. Canonical auto_core.dll and
# auto_core.lib live in lib/. Published copies live in tracked bin/.
# Do not ignore lib/ or *.dll. dist/ is the ignored local installation.
# Developer scripts under scripts/ stay tracked.
*.exp

# Logs and temporary files
*.log
*.tmp
*.temp

# Windows system files
Thumbs.db
Desktop.ini

# Editor/IDE settings and per-user Visual Studio state
.vs/
.vs
*.suo
*.vcxproj.user
.vscode/
.idea/

# Precompiled-header intermediates
ipch/

# Environment/secrets
.env
.env.*

*.db

# Local overlays kept on this machine; not part of a public clone
*.local.ixx
*.local.ini

# Runtime output (exes, DLLs, live config, local data)
dist/

# Linker program databases (developer symbols; not part of dist/)
symbols/
