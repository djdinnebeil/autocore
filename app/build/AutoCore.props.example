<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup Label="UserMacros">
    <!-- Directory for compiler intermediates and Visual Studio build data. -->
    <AutoCoreBuildDir>C:\Path\To\AutoCore-Build\</AutoCoreBuildDir>

    <!-- Auto Core repository directories. -->
    <AutoCoreLibDir>C:\Path\To\Auto-Core\lib\</AutoCoreLibDir>
    <AutoCoreDistDir>C:\Path\To\Auto-Core\dist\</AutoCoreDistDir>
    <AutoCoreSymbolsDir>C:\Path\To\Auto-Core\dist\symbols\</AutoCoreSymbolsDir>

  </PropertyGroup>

  <ItemGroup>
    <BuildMacro Include="AutoCoreBuildDir">
      <Value>$(AutoCoreBuildDir)</Value>
      <EnvironmentVariable>true</EnvironmentVariable>
    </BuildMacro>

    <BuildMacro Include="AutoCoreLibDir">
      <Value>$(AutoCoreLibDir)</Value>
      <EnvironmentVariable>true</EnvironmentVariable>
    </BuildMacro>

    <BuildMacro Include="AutoCoreDistDir">
      <Value>$(AutoCoreDistDir)</Value>
      <EnvironmentVariable>true</EnvironmentVariable>
    </BuildMacro>

    <BuildMacro Include="AutoCoreSymbolsDir">
      <Value>$(AutoCoreSymbolsDir)</Value>
      <EnvironmentVariable>true</EnvironmentVariable>
    </BuildMacro>

  </ItemGroup>

</Project>
